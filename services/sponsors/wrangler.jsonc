{
  "name": "olivecode-reporting",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "REPORTING", "class_name": "Reporting" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reporting"] }],
}
